# Unreal Engine generated files
Binaries/*
Plugins/**/Binaries/*

# Build output (keep Unreal packaging deny-lists and application icons)
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

Saved/*
Intermediate/*
Plugins/**/Intermediate/*
DerivedDataCache/*

# Built data for maps
*_BuiltData.uasset

# Precompiled source-art assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Project files generated by Unreal Engine or an IDE
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/
.vsconfig
*.user
*.userprefs

# Compiled object files and precompiled headers
*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# Compiled libraries
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib

# Executables and packaged applications
*.exe
*.out
*.app
*.ipa

# Build and debug artifacts
*.tmp
*.log
*.pdb

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
